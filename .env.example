# Which provider runs the agent: "baseten" (Muse Spark Open) or "meta" (Meta Model API)
LLM_PROVIDER=baseten

# Baseten — Muse Spark Open (open weights). Key works only with this exact model name.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Meta Model API — take the base URL and model id from the Meta docs (Quickstart / Model list)
META_API_KEY=
META_BASE_URL=
META_MODEL=

# Agent settings
MAX_STEPS=25
MAX_TOKENS=4096
HEADLESS=true

# Web UI
UI_PORT=5174
# 127.0.0.1 keeps the UI on this machine. On a server use 0.0.0.0 and set UI_PASSWORD.
HOST=127.0.0.1
# Comma-separated origins allowed to start runs, e.g. https://probei.example.com
ALLOWED_ORIGIN=
# HTTP Basic auth password for the UI (any user name). Required when HOST is not local.
UI_PASSWORD=
# Max steps per run started from the UI
UI_MAX_STEPS=30
# Let the agent open localhost and private networks. Default: true when HOST is local, false otherwise.
ALLOW_PRIVATE_URLS=
