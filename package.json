{
  "name": "probei",
  "version": "0.1.0",
  "private": true,
  "description": "Visual QA agent on Meta models: tests a web app from a plain-language scenario and writes a bug report.",
  "type": "module",
  "scripts": {
    "probe": "tsx src/cli.ts",
    "zoo": "node zoo/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "browsers": "playwright install chromium",
    "ui": "tsx src/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "openai": "^7.45.1",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
